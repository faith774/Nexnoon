# ============================================
# Nexnoon Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# Backend API
# ============================================
# The backend API base URL (no /v1 suffix; routes add it)
VITE_API_BASE_URL=http://localhost:4000/v1

# ============================================
# Admin portal (Optional)
# ============================================
# Leave empty to serve the admin portal at /admin on this site.
# In production set it to the admin subdomain; /admin on the public site then redirects there.
# Locally you can test the subdomain at http://admin.localhost:5173 without setting anything.
VITE_ADMIN_PORTAL_URL=
# Public site origin, used by the admin portal for "View site" and class links.
VITE_PUBLIC_SITE_URL=

# ============================================
# Stripe (Optional - for payments)
# ============================================
# Get this from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ============================================
# Demo Mode (Optional)
# ============================================
# Set to false to use real API; true for mock data
VITE_ENABLE_DEMO_MODE=false

# ============================================
# Analytics (Optional)
# ============================================
VITE_ENABLE_ANALYTICS=false
