# ===========================================
# Nexnoon Frontend - Environment Variables
# ===========================================
# Copy this file to .env in the same folder and fill in your values.
# In Cursor/VS Code: copy env.example to .env (dotfiles may be hidden in the tree).
# All Vite env vars must be prefixed with VITE_ to be exposed to the app.

# -----------------------------------------------------------------------------
# API Configuration (required for real backend)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/v1

# -----------------------------------------------------------------------------
# Stripe (required for real payments)
# -----------------------------------------------------------------------------
# Publishable key from https://dashboard.stripe.com/apikeys (safe to use in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Zoom (optional)
# -----------------------------------------------------------------------------
# Meeting SDK secrets stay on the BACKEND only (ZOOM_MEETING_SDK_*).
# See nexnoon/docs/ZOOM_INTEGRATION.md — no Zoom secret should live in Vite.
# VITE_ZOOM_SDK_KEY is unused by the current Meeting SDK join flow (signature from API).

# -----------------------------------------------------------------------------
# Agora (optional - for Agora-based video/live classes)
# -----------------------------------------------------------------------------
VITE_AGORA_APP_ID=
VITE_AGORA_TOKEN_SERVER_URL=

# -----------------------------------------------------------------------------
# Feature flags (optional)
# -----------------------------------------------------------------------------
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_ANALYTICS=false
