# ===========================================
# Nexnoon Backend - Environment Variables
# ===========================================
# Copy this file to .env in the same folder and fill in your values.
# Never commit .env (it is in .gitignore).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# -----------------------------------------------------------------------------
# MongoDB (required)
# -----------------------------------------------------------------------------
# Local Docker (docker compose up -d from nexnoon/):
#   mongodb://127.0.0.1:27017/nexnon
# Atlas: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/nexnon?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexnon

# -----------------------------------------------------------------------------
# JWT (required - use strong random secrets in production)
# -----------------------------------------------------------------------------
# Generate: openssl rand -base64 32 (run twice for access and refresh)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Stripe (optional - leave empty for demo payments)
# -----------------------------------------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys (backend only)
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe Dashboard → Webhooks (for production)
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Frontend URL (required for CORS and email links)
# -----------------------------------------------------------------------------
# Local dev: http://localhost:5173  |  Production: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Email / SMTP (optional - leave empty to skip sending emails)
# -----------------------------------------------------------------------------
EMAIL_FROM=no-reply@nexnoon.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Zoom (optional - leave empty for demo meeting links)
# -----------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Optional: use if local DNS times out on Atlas SRV lookups. Leave empty on working networks.
# Example: 1.1.1.1,8.8.8.8
MONGODB_DNS_SERVERS=
