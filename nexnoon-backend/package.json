{
  "name": "nexnoon-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev:local": "npm run dev",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:logs": "docker compose -f ../docker-compose.yml logs -f mongodb",
    "test": "npm run build && node --test tests/local-api.test.cjs tests/zoom-lifecycle.test.cjs",
    "seed:demo": "npm run build && node scripts/seed-demo.cjs",
    "seed:catalog": "npm run seed:demo && node scripts/seed-catalog.cjs",
    "demo:atlas": "node scripts/import-demo-atlas.cjs"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.16",
    "stripe": "^16.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.24",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
