# ============================================
# Nexnoon Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# Core Configuration
# ============================================
NODE_ENV=development
PORT=4000

# ============================================
# MongoDB Database
# ============================================
# Local Docker Mongo (from nexnoon/: docker compose up -d):
#   mongodb://127.0.0.1:27017/nexnon
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/nexnon
MONGODB_URI=mongodb://127.0.0.1:27017/nexnon

# ============================================
# JWT Authentication
# ============================================
# Generate secure random strings for these (use: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Stripe Payment Integration
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys
# Test keys start with: sk_test_ and pk_test_
# Live keys start with: sk_live_ and pk_live_
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here


# ============================================
# Email Configuration (SMTP / Brevo)
# ============================================
# Brevo (recommended): https://app.brevo.com/settings/keys/smtp
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your Brevo account email
#   SMTP_PASS=your Brevo SMTP key
# Also works with Gmail, SendGrid, Mailgun, AWS SES.
EMAIL_FROM="Nexnoon <no-reply@nexnoon.com>"
CONTACT_EMAIL=support@nexnoon.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASS=your-brevo-smtp-key

# ============================================
# Frontend URL
# ============================================
# Used for generating links in emails (password reset, email verification)
FRONTEND_URL=http://localhost:5173
# Admin portal origin (e.g. https://admin.nexnoon.com). Added to the production CORS allow list.
ADMIN_URL=

# ============================================
# Zoom Integration
# ============================================
# Full guide: nexnoon/docs/ZOOM_INTEGRATION.md
# Marketplace: https://marketplace.zoom.us/develop/create
#
# 1) Server-to-Server OAuth app — create/update meetings + host start URL
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# 2) Meeting SDK credentials — learner in-browser join (signatures minted on backend)
# Do NOT put Meeting SDK secrets in the frontend .env
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=

# 3) Event Subscriptions secret — meeting.started / meeting.ended
# Webhook URL: https://YOUR_API_HOST/v1/zoom/webhook
ZOOM_WEBHOOK_SECRET_TOKEN=

# Live class join-window policy (minutes)
LIVE_CLASS_JOIN_EARLY_MINUTES=15
LIVE_CLASS_LATE_JOIN_GRACE_MINUTES=30
LIVE_CLASS_HOST_EARLY_MINUTES=60

# Zoom meeting defaults: waiting room (true/false) and automatic recording (none | cloud | local)
ZOOM_WAITING_ROOM=false
ZOOM_AUTO_RECORDING=none

# Session reminders (in-app + email) to learners and the teaching team. Set to off to disable.
SESSION_REMINDERS=on
# Minutes before start for each reminder; 0 = "starting now". A 24 h reminder is always sent too.
SESSION_REMINDER_MINUTES=30,20,10,5,0

# Optional: use if local DNS times out on Atlas SRV lookups. Leave empty on working networks.
# Example: 1.1.1.1,8.8.8.8
MONGODB_DNS_SERVERS=

# ============================================
# Cloudinary (Optional)
# ============================================
# Powers instructor file uploads for course materials and assignment attachments
# (POST /v1/classes/:id/uploads). Leave empty to disable uploads (returns 503).
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
