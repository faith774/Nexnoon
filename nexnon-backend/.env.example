# ============================================
# Nexnoon Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# Core Configuration
# ============================================
NODE_ENV=development
PORT=4000

# ============================================
# MongoDB Database
# ============================================
# Local MongoDB: mongodb://localhost:27017/nexnon
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/nexnon
MONGODB_URI=mongodb://127.0.0.1:27017/nexnoon

# ============================================
# JWT Authentication
# ============================================
# Generate secure random strings for these (use: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Stripe Payment Integration
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys
# Test keys start with: sk_test_ and pk_test_
# Live keys start with: sk_live_ and pk_live_
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here


# ============================================
# Email Configuration (SMTP)
# ============================================
# Examples for common providers:
# Gmail: smtp.gmail.com, port 587
# SendGrid: smtp.sendgrid.net, port 587
# Mailgun: smtp.mailgun.org, port 587
# AWS SES: email-smtp.region.amazonaws.com, port 587
EMAIL_FROM="Nexnoon <no-reply@nexnon.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ============================================
# Frontend URL
# ============================================
# Used for generating links in emails (password reset, email verification)
FRONTEND_URL=http://localhost:5173

# ============================================
# Zoom Integration (Optional)
# ============================================
# Server-to-Server OAuth (for automatic meeting creation)
# Get these from: https://marketplace.zoom.us/develop/create
# Create a Server-to-Server OAuth app
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Meeting SDK (for embedded student joining)
# Get these from: https://marketplace.zoom.us/develop/create
# Create or use an existing app with Meeting SDK enabled
ZOOM_MEETING_SDK_CLIENT_ID=your_zoom_meeting_sdk_client_id
ZOOM_MEETING_SDK_CLIENT_SECRET=your_zoom_meeting_sdk_client_secret

# Webhook signature verification (Zoom App Marketplace -> your app -> Feature -> Event Subscriptions)
# Required for the /v1/zoom/webhook endpoint to accept events; leave empty to reject all webhook calls.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Live class join-window policy (minutes). Defaults shown below.
LIVE_CLASS_JOIN_EARLY_MINUTES=15
LIVE_CLASS_LATE_JOIN_GRACE_MINUTES=30

# Optional: use if local DNS times out on Atlas SRV lookups. Leave empty on working networks.
# Example: 1.1.1.1,8.8.8.8
MONGODB_DNS_SERVERS=

# ============================================
# Cloudinary (Optional)
# ============================================
# Powers instructor file uploads for course materials and assignment attachments
# (POST /v1/classes/:id/uploads). Leave empty to disable uploads (returns 503).
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
